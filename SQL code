-- 5. Display All Players
SELECT * FROM game;

-- 6. Display Winners
SELECT * FROM game
WHERE result = 'Won';

-- 7. Display Losers
SELECT * FROM game
WHERE result = 'Lost';

-- 8. Count Total Players
SELECT COUNT(*) AS total_players
FROM game;

-- 9. Count Winners
SELECT COUNT(*) AS total_winners
FROM game
WHERE result = 'Won';

-- 10. Count Losers
SELECT COUNT(*) AS total_losers
FROM game
WHERE result = 'Lost';

-- 11. Find the Player With Least Attempts
SELECT *
FROM game
ORDER BY attempts ASC
LIMIT 1;
