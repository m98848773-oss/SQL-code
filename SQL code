-- 1. Create Database
CREATE DATABASE number_game;

-- 2. Use Database
USE number_game;

-- 3. Create Table
CREATE TABLE game (
    id INT AUTO_INCREMENT PRIMARY KEY,
    player_name VARCHAR(50),
    secret_number INT,
    guessed_number INT,
    attempts INT,
    result VARCHAR(20)
);

